{
  "name": "dsh-computer-use",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown --config packages/computer/tsdown.config.ts && tsdown --config packages/computer-playwright/tsdown.config.ts && tsdown --config packages/computer-macos/tsdown.config.ts && tsdown --config packages/tool-computer/tsdown.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -b packages/computer packages/computer-playwright packages/computer-macos packages/tool-computer",
    "build:helper": "swiftc -O packages/computer-macos/helper/main.swift -o packages/computer-macos/helper/dsh-computer-macos-helper"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-attachment": "link:../deepseek-harness/packages/attachment/attachment",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
    "@types/node": "^22.19.0",
    "playwright-core": "^1.61.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
