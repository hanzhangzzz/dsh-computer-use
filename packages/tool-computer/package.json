{
  "name": "dsh-tool-computer",
  "version": "0.3.0",
  "description": "Computer use plugin for DeepSeek Harness: one plugin composing the computer seam, a Playwright provider, and the computer_* tools",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "computer-use"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib/index.d.ts",
    "lib/index.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "huajuan404",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzhangzzz/dsh-computer-use.git"
  },
  "bugs": {
    "url": "https://github.com/hanzhangzzz/dsh-computer-use/issues"
  },
  "dependencies": {
    "playwright-core": "^1.61.0"
  }
}
